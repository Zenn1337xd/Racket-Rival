-- =======================================================
-- SHUTTLECOCK / BADMINTON TRACKER
-- =======================================================
local function getActiveShuttle()
    for _, name in ipairs({"Shuttle", "Shuttlecock", "Birdie", "Badminton", "Ball"}) do
        local direct = workspace:FindFirstChild(name, true)
        if direct and direct:IsA("BasePart") and not direct:IsDescendantOf(character) then
            return direct
        end
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(character) then
            local lName = string.lower(obj.Name)
            if (string.find(lName, "shuttle") or string.find(lName, "birdie") or string.find(lName, "badminton"))
               and not string.find(lName, "gui") and not string.find(lName, "spawner") and not string.find(lName, "net") then
                return obj
            end
        end
    end

    -- Physics velocity fallback
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("BasePart") and not obj.Anchored and obj.AssemblyLinearVelocity.Magnitude > 8 then
            if obj.Size.Magnitude < 8 and not Players:GetPlayerFromCharacter(obj.Parent) then
                return obj
            end
        end
    end
    return nil
end

local function getEnemyCourtPosition()
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return Vector3.zero end

    local closestDist = math.huge
    local targetPos = nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local eRoot = p.Character.HumanoidRootPart
            local dist = (root.Position - eRoot.Position).Magnitude
            if dist > 18 and dist < closestDist then
                closestDist = dist
                targetPos = eRoot.Position
            end
        end
    end

    if not targetPos then
        targetPos = root.Position + (root.CFrame.LookVector * 65)
    end
    return targetPos
end

-- =======================================================
-- AGGRESSIVE AIMBOT & AUTO-PUNCH PIPELINE
-- =======================================================
local aimbotPunchEnabled = false
local autoFollowEnabled = false
local rushSpeed = 42
local isPunching = false

local function executeAggressivePunch(shuttlePart, enemyPos)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not shuttlePart then return end

    -- 1. Hard Aim lock towards opponent
    root.CFrame = CFrame.new(root.Position, Vector3.new(enemyPos.X, root.Position.Y, enemyPos.Z))

    -- 2. Physical Hitbox Touch Injection
    local racket = character:FindFirstChildWhichIsA("Tool") or character:FindFirstChild("Racket")
    local hitPart = (racket and racket:FindFirstChildWhichIsA("BasePart")) or root
    if firetouchinterest then
        pcall(function()
            firetouchinterest(hitPart, shuttlePart, 0)
            task.wait(0.02)
            firetouchinterest(hitPart, shuttlePart, 1)
        end)
    end

    -- 3. Trigger equipped tool
    if racket and racket:IsA("Tool") then
        racket:Activate()
    end

    -- 4. Screen Tap Simulation (Mobile Racket Hit Button)
    pcall(function()
        local vp = workspace.CurrentCamera.ViewportSize
        VirtualUser:Button1Down(Vector2.new(vp.X * 0.85, vp.Y * 0.70), workspace.CurrentCamera.CFrame)
        task.wait(0.03)
        VirtualUser:Button1Up(Vector2.new(vp.X * 0.85, vp.Y * 0.70), workspace.CurrentCamera.CFrame)
    end)

    -- 5. Trigger all registered mobile buttons in PlayerGui
    pcall(function()
        local pGui = player:FindFirstChild("PlayerGui")
        if pGui then
            for _, btn in ipairs(pGui:GetDescendants()) do
                if (btn:IsA("ImageButton") or btn:IsA("TextButton")) and btn.Visible then
                    local bName = string.lower(btn.Name)
                    local bImg = string.lower(btn:IsA("ImageButton") and btn.Image or "")
                    if string.find(bName, "hit") or string.find(bName, "swing") or string.find(bName, "smash") 
                       or string.find(bName, "strike") or string.find(bImg, "shuttle") then
                        if firesignal then
                            firesignal(btn.Activated)
                            firesignal(btn.MouseButton1Click)
                        elseif getconnections then
                            for _, c in ipairs(getconnections(btn.Activated)) do c:Fire() end
                            for _, c in ipairs(getconnections(btn.MouseButton1Click)) do c:Fire() end
                        end
                    end
                end
            end
        end
    end)

    -- 6. Remote Invocation
    pcall(function()
        for _, rem in ipairs(ReplicatedStorage:GetDescendants()) do
            if rem:IsA("RemoteEvent") then
                local rName = string.lower(rem.Name)
                if string.find(rName, "hit") or string.find(rName, "swing") or string.find(rName, "smash") or string.find(rName, "play") then
                    rem:FireServer(shuttlePart, enemyPos)
                end
            end
        end
    end)
end

-- Aimbot & Follow Loop
RunService.Heartbeat:Connect(function()
    if not (aimbotPunchEnabled or autoFollowEnabled) then return end

    local root = character and character:FindFirstChild("HumanoidRootPart")
    local hum = character and character:FindFirstChildWhichIsA("Humanoid")
    if not root or not hum then return end

    local shuttle = getActiveShuttle()
    if shuttle and shuttle.Parent then
        local flatDist = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(shuttle.Position.X, 0, shuttle.Position.Z)).Magnitude
        local totalDist = (root.Position - shuttle.Position).Magnitude

        -- Follow ball trajectory
        if autoFollowEnabled and flatDist > 3.5 then
            hum.WalkSpeed = rushSpeed
            hum:MoveTo(Vector3.new(shuttle.Position.X, root.Position.Y, shuttle.Position.Z))
        end

        -- Auto-Punch when shuttle enters hitting range
        if aimbotPunchEnabled and totalDist <= 18 and not isPunching then
            isPunching = true

            local enemyPos = getEnemyCourtPosition()

            -- Auto-Jump on high lobs
            if shuttle.Position.Y > (root.Position.Y + 4) then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end

            executeAggressivePunch(shuttle, enemyPos)
            task.wait(0.2)
            isPunching = false
        end
    else
        if hum.WalkSpeed == rushSpeed then
            hum.WalkSpeed = 16
        end
    end
end)

-- =======================================================
-- UNLOCK ALL RACKETS (STORE & INVENTORY SPONSOR)
-- =======================================================
local function unlockAllRackets()
    local unlockedCount = 0

    -- 1. Scan ReplicatedStorage / Assets for Racket storage
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("Tool") and (string.find(string.lower(obj.Name), "racket") or string.find(string.lower(obj.Parent.Name), "racket")) then
            if not player.Backpack:FindFirstChild(obj.Name) and not character:FindFirstChild(obj.Name) then
                local clone = obj:Clone()
                clone.Parent = player.Backpack
                unlockedCount = unlockedCount + 1
            end
        end
    end

    -- 2. Probe equip and inventory remotes
    pcall(function()
        for _, rem in ipairs(ReplicatedStorage:GetDescendants()) do
            if rem:IsA("RemoteEvent") or rem:IsA("RemoteFunction") then
                local rName = string.lower(rem.Name)
                if string.find(rName, "equip") or string.find(rName, "select") or string.find(rName, "buy") or string.find(rName, "unlock") then
                    for id = 1, 60 do
                        if rem:IsA("RemoteEvent") then
                            rem:FireServer(id)
                            rem:FireServer(tostring(id))
                        else
                            rem:InvokeServer(id)
                        end
                    end
                end
            end
        end
    end)

    notify("Rackets", "All available rackets loaded into inventory!")
end

-- =======================================================
-- REAL FE INVISIBILITY (DESYNC GHOST ENGINE)
-- =======================================================
local isInvisible = false
local invisConn = nil

local function toggleInvisibility(state)
    isInvisible = state
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if state then
        -- Desync local character representation from server camera/collider
        pcall(function()
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.Transparency = 1
                elseif part:IsA("Decal") then
                    part.Transparency = 1
                end
            end

            local lowerTorso = character:FindFirstChild("LowerTorso")
            local rootJoint = lowerTorso and lowerTorso:FindFirstChild("Root")
            if rootJoint then
                rootJoint.C0 = CFrame.new(0, 100000, 0)
            else
                root.CFrame = root.CFrame * CFrame.new(0, 0.05, 0)
            end
        end)

        invisConn = RunService.RenderStepped:Connect(function()
            if character and character:FindFirstChildWhichIsA("Humanoid") then
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.Transparency = 1
                    end
                end
            end
        end)
        notify("Invisibility", "True Invisibility Activated (Desynced)!")
    else
        if invisConn then
            invisConn:Disconnect()
            invisConn = nil
        end

        pcall(function()
            local lowerTorso = character:FindFirstChild("LowerTorso")
            local rootJoint = lowerTorso and lowerTorso:FindFirstChild("Root")
            if rootJoint then
                rootJoint.C0 = CFrame.new(0, 0, 0)
            end

            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.Transparency = 0
                elseif part:IsA("Decal") then
                    part.Transparency = 0
                end
            end
        end)
        notify("Invisibility", "Invisibility Disabled.")
    end
end

