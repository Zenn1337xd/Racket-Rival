-- ADMIN GLOBAL ANNOUNCEMENT SYSTEM (Secret ✔)
-- =======================================================
local function broadcastGlobalAnnouncement(rawMessage)
    if not rawMessage or string.gsub(rawMessage, "%s+", "") == "" then
        notify("Announcement", "Please write a message first!")
        return
    end

    -- Verified Name formatting: Secret ✔
    local formattedText = string.format("[📢 GLOBAL ANNOUNCEMENT] Secret ✔: %s !!!", rawMessage)

    -- 1. Modern TextChatService Broadcast (Everyone in server sees this)
    pcall(function()
        local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if generalChannel then
            generalChannel:SendAsync(formattedText)
        end
    end)

    -- 2. Legacy Chat System Broadcast Fallback
    pcall(function()
        local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if chatEvents and chatEvents:FindFirstChild("SayMessageRequest") then
            chatEvents.SayMessageRequest:FireServer(formattedText, "All")
        end
    end)

    -- 3. Scan for Server-Wide Announcement Remotes
    pcall(function()
        for _, rem in ipairs(ReplicatedStorage:GetDescendants()) do
            if rem:IsA("RemoteEvent") then
                local rName = string.lower(rem.Name)
                if string.find(rName, "announce") or string.find(rName, "broadcast") or string.find(rName, "globalchat") or string.find(rName, "notify") then
                    rem:FireServer(formattedText)
                    rem:FireServer("Secret ✔", rawMessage .. " !!!")
                end
            end
        end
    end)

    -- 4. In-Game Local Notification Confirmation
    notify("Secret ✔ [Verified]", rawMessage .. " !!!")
end

