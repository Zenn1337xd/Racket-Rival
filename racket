-- =======================================================
-- SHUTTLECOCK / BADMINTON TRACKER
-- =======================================================
local function getActiveShuttle()
    -- 1. Direct workspace names
    for _, name in ipairs({"Shuttle", "Shuttlecock", "Birdie", "Badminton", "Ball"}) do
        local direct = workspace:FindFirstChild(name, true)
        if direct and direct:IsA("BasePart") and not direct:IsDescendantOf(character) then
            return direct
        end
    end

    -- 2. Scan workspace descendants
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(character) then
            local lName = string.lower(obj.Name)
            if (string.find(lName, "shuttle") or string.find(lName, "birdie") or string.find(lName, "badminton")) 
               and not string.find(lName, "spawner") and not string.find(lName, "gui") then
                return obj
            end
        end
    end
    return nil
end

-- Locate Opponent Court
local function getEnemyPosition()
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return Vector3.zero end

    local closestDist = math.huge
    local targetPos = nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local eRoot = p.Character.HumanoidRootPart
            local dist = (root.Position - eRoot.Position).Magnitude
            if dist > 18 and dist < closestDist then
                closestDist = dist
                targetPos = eRoot.Position
            end
        end
    end

    if not targetPos then
        targetPos = root.Position + (root.CFrame.LookVector * 50)
    end
    return targetPos
end

-- =======================================================
-- AUTO PLAY & SWING ENGINE
-- =======================================================
local autoPlayEnabled = false
local speedRushEnabled = true
local rushSpeedValue = 38
local hitCooldown = false

local function executeRacketSwing(targetPos)
    -- Turn character to face enemy court
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root and targetPos then
        root.CFrame = CFrame.new(root.Position, Vector3.new(targetPos.X, root.Position.Y, targetPos.Z))
    end

    -- Method A: Trigger mobile swing UI button directly
    pcall(function()
        local pGui = player:FindFirstChild("PlayerGui")
        if pGui then
            for _, btn in ipairs(pGui:GetDescendants()) do
                if (btn:IsA("ImageButton") or btn:IsA("TextButton")) and btn.Visible then
                    local bName = string.lower(btn.Name)
                    if string.find(bName, "hit") or string.find(bName, "swing") or string.find(bName, "smash") or string.find(bName, "strike") then
                        for _, conn in ipairs(getconnections(btn.Activated)) do conn:Fire() end
                        for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do conn:Fire() end
                        for _, conn in ipairs(getconnections(btn.MouseButton1Down)) do conn:Fire() end
                    end
                end
            end
        end
    end)

    -- Method B: Virtual Input Event
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.04)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        task.wait(0.04)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
    end)

    -- Method C: Network Remotes
    pcall(function()
        for _, r in ipairs(ReplicatedStorage:GetDescendants()) do
            if r:IsA("RemoteEvent") then
                local rName = string.lower(r.Name)
                if string.find(rName, "hit") or string.find(rName, "swing") or string.find(rName, "smash") then
                    r:FireServer(targetPos)
                end
            end
        end
    end)
end

-- Auto Play & Speed Rush Heartbeat Loop
RunService.Heartbeat:Connect(function()
    if not autoPlayEnabled then return end

    local root = character and character:FindFirstChild("HumanoidRootPart")
    local hum = character and character:FindFirstChildWhichIsA("Humanoid")
    if not root or not hum then return end

    local shuttle = getActiveShuttle()
    if shuttle and shuttle.Parent then
        local flatDistance = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(shuttle.Position.X, 0, shuttle.Position.Z)).Magnitude
        local totalDistance = (root.Position - shuttle.Position).Magnitude

        -- Speed Rush: Sprint directly to the ball's position
        if flatDistance > 5 then
            if speedRushEnabled then
                hum.WalkSpeed = rushSpeedValue
            end
            hum:MoveTo(Vector3.new(shuttle.Position.X, root.Position.Y, shuttle.Position.Z))
        end

        -- In Strike Range: Auto-Aim and Punch/Swing toward opponent
        if totalDistance <= 16 and not hitCooldown then
            hitCooldown = true

            local enemyPos = getEnemyPosition()

            -- High lob jump counter
            if shuttle.Position.Y > (root.Position.Y + 5) then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end

            executeRacketSwing(enemyPos)
            task.wait(0.2)
            hitCooldown = false
        end
    else
        if hum.WalkSpeed == rushSpeedValue then
            hum.WalkSpeed = 16
        end
    end
end)

-- =======================================================
-- BADMINTON COLOR SCANNER / ESP
-- =======================================================
local scanEnabled = true
local currentHighlight = nil
local currentBillboard = nil

local function removeBallVisuals()
    if currentHighlight and currentHighlight.Parent then
        currentHighlight:Destroy()
        currentHighlight = nil
    end
    if currentBillboard and currentBillboard.Parent then
        currentBillboard:Destroy()
        currentBillboard = nil
    end
end

RunService.RenderStepped:Connect(function()
    if not scanEnabled then
        removeBallVisuals()
        return
    end

    local shuttle = getActiveShuttle()
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if shuttle and shuttle.Parent then
        if not currentHighlight or currentHighlight.Adornee ~= shuttle then
            removeBallVisuals()

            local hl = Instance.new("Highlight")
            hl.Name = "BadmintonHighlight"
            hl.FillColor = THEME.BallNeon
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.FillTransparency = 0.2
            hl.OutlineTransparency = 0
            hl.Adornee = shuttle
            hl.Parent = shuttle
            currentHighlight = hl

            local bill = Instance.new("BillboardGui")
            bill.Name = "BadmintonTracker"
            bill.Size = UDim2.new(0, 100, 0, 30)
            bill.AlwaysOnTop = true
            bill.Adornee = shuttle

            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.TextColor3 = THEME.BallNeon
            txt.TextStrokeTransparency = 0
            txt.Font = Enum.Font.GothamBold
            txt.TextSize = 11
            txt.Text = "🏸 BADMINTON"
            txt.Parent = bill

            bill.Parent = shuttle
            currentBillboard = bill
        end

        if currentBillboard and root then
            local dist = math.floor((root.Position - shuttle.Position).Magnitude * 0.28)
            local lbl = currentBillboard:FindFirstChildWhichIsA("TextLabel")
            if lbl then
                lbl.Text = string.format("🏸 BADMINTON\n%dm", dist)
            end
        end
    else
        removeBallVisuals()
    end
end)

