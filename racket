-- =======================================================
-- BADMINTON SHUTTLECOCK / BALL DETECTOR
-- =======================================================
local function getActiveBadminton()
    -- Check common projectile names in Racket Rival
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = string.lower(obj.Name)
            if string.find(name, "birdie") or string.find(name, "shuttlecock") or string.find(name, "badminton") or (string.find(name, "ball") and not string.find(name, "spawner")) then
                return obj
            end
        end
    end
    return nil
end

-- Find Closest Enemy / Opponent
local function getEnemyPosition()
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local closestDist = math.huge
    local targetPos = nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (root.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if dist > 20 and dist < closestDist then -- Across the net
                closestDist = dist
                targetPos = p.Character.HumanoidRootPart.Position
            end
        end
    end

    -- Fallback: Point toward opponent's side of court
    if not targetPos then
        targetPos = root.Position + (root.CFrame.LookVector * 50)
    end
    return targetPos
end

-- =======================================================
-- AIMBOT & AUTO-HIT ENGINE
-- =======================================================
local aimbotEnabled = false
local hitCooldown = false

local function triggerRacketSwing(targetPos)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Turn to face opponent's court / enemy
    if targetPos then
        root.CFrame = CFrame.new(root.Position, Vector2.new(targetPos.X, root.Position.Y, targetPos.Z))
    end

    -- 1. Activate equipped racket tool
    local tool = character:FindFirstChildWhichIsA("Tool")
    if tool then
        tool:Activate()
    end

    -- 2. Fire Game Swing Remote if available
    for _, r in ipairs(ReplicatedStorage:GetDescendants()) do
        if (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) and (string.find(string.lower(r.Name), "hit") or string.find(string.lower(r.Name), "swing") or string.find(string.lower(r.Name), "punch")) then
            pcall(function()
                if r:IsA("RemoteEvent") then
                    r:FireServer(targetPos)
                else
                    r:InvokeServer(targetPos)
                end
            end)
        end
    end
end

-- Auto Hit Loop
RunService.Heartbeat:Connect(function()
    if not aimbotEnabled or hitCooldown then return end
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local birdie = getActiveBadminton()
    if birdie and birdie.Parent then
        local dist = (root.Position - birdie.Position).Magnitude

        -- Trigger hit when birdie enters strike zone (under 14 studs)
        if dist <= 14 then
            hitCooldown = true
            local enemyPos = getEnemyPosition()
            triggerRacketSwing(enemyPos)
            task.wait(0.2)
            hitCooldown = false
        end
    end
end)

-- =======================================================
-- BADMINTON COLOR SCANNER / ESP
-- =======================================================
local scanEnabled = false
local currentHighlight = nil
local currentBillboard = nil

local function removeBallVisuals()
    if currentHighlight and currentHighlight.Parent then
        currentHighlight:Destroy()
        currentHighlight = nil
    end
    if currentBillboard and currentBillboard.Parent then
        currentBillboard:Destroy()
        currentBillboard = nil
    end
end

RunService.RenderStepped:Connect(function()
    if not scanEnabled then
        removeBallVisuals()
        return
    end

    local birdie = getActiveBadminton()
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if birdie and birdie.Parent then
        -- Attach Neon Highlight
        if not currentHighlight or currentHighlight.Adornee ~= birdie then
            removeBallVisuals()

            local hl = Instance.new("Highlight")
            hl.Name = "BadmintonHighlight"
            hl.FillColor = THEME.BallNeon
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.FillTransparency = 0.2
            hl.OutlineTransparency = 0
            hl.Adornee = birdie
            hl.Parent = birdie
            currentHighlight = hl

            -- Overhead Indicator
            local bill = Instance.new("BillboardGui")
            bill.Name = "BadmintonTracker"
            bill.Size = UDim2.new(0, 100, 0, 30)
            bill.AlwaysOnTop = true
            bill.Adornee = birdie

            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.TextColor3 = THEME.BallNeon
            txt.TextStrokeTransparency = 0
            txt.Font = Enum.Font.GothamBold
            txt.TextSize = 11
            txt.Text = "🏸 BADMINTON"
            txt.Parent = bill

            bill.Parent = birdie
            currentBillboard = bill
        end

        if currentBillboard and root then
            local dist = math.floor((root.Position - birdie.Position).Magnitude * 0.28)
            local lbl = currentBillboard:FindFirstChildWhichIsA("TextLabel")
            if lbl then
                lbl.Text = string.format("🏸 BADMINTON\n%dm", dist)
            end
        end
    else
        removeBallVisuals()
    end
end)

-- =======================================================
-- JUMP 5X & SPEED 10% COUNTER
-- =======================================================
local jumpHighEnabled = false
local infJumpEnabled = false
local jumpConn = nil

local function updateMovementStats()
    if character and character:FindFirstChildWhichIsA("Humanoid") then
        local hum = character:FindFirstChildWhichIsA("Humanoid")

        if jumpHighEnabled then
            -- Jump High 5x
            if hum.UseJumpPower then
                hum.JumpPower = 250 -- Standard is 50
            else
                hum.JumpHeight = 36 -- Standard is 7.2
            end
            -- +10% Counter Speed (16 * 1.10 = 17.6)
            hum.WalkSpeed = 18
        else
            if hum.UseJumpPower then
                hum.JumpPower = 50
            else
                hum.JumpHeight = 7.2
            end
            hum.WalkSpeed = 16
        end
    end
end

local function setInfJump(enabled)
    infJumpEnabled = enabled
    if jumpConn then jumpConn:Disconnect() jumpConn = nil end
    if enabled then
        jumpConn = UserInputService.JumpRequest:Connect(function()
            if character and character:FindFirstChildWhichIsA("Humanoid") then
                character:FindFirstChildWhichIsA("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end
end

