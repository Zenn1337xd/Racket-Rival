local isInvisible = false
local invisConn = nil

local function toggleInvisibility(state)
    isInvisible = state
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if state then
        pcall(function()
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.Transparency = 1
                elseif part:IsA("Decal") then
                    part.Transparency = 1
                end
            end

            local lowerTorso = character:FindFirstChild("LowerTorso")
            local rootJoint = lowerTorso and lowerTorso:FindFirstChild("Root")
            if rootJoint then
                rootJoint.C0 = CFrame.new(0, 100000, 0)
            end
        end)

        invisConn = RunService.RenderStepped:Connect(function()
            if character then
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.Transparency = 1
                    end
                end
            end
        end)
        notify("Invisibility", "True Invisibility Active!")
    else
        if invisConn then
            invisConn:Disconnect()
            invisConn = nil
        end

        pcall(function()
            local lowerTorso = character:FindFirstChild("LowerTorso")
            local rootJoint = lowerTorso and lowerTorso:FindFirstChild("Root")
            if rootJoint then
                rootJoint.C0 = CFrame.new(0, 0, 0)
            end

            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.Transparency = 0
                elseif part:IsA("Decal") then
                    part.Transparency = 0
                end
            end
        end)
        notify("Invisibility", "Invisibility Disabled.")
    end
end

