-- =======================================================
-- ENHANCED SHUTTLECOCK DETECTOR
-- =======================================================
local function getActiveShuttle()
    -- 1. Scan primary projectile names
    for _, name in ipairs({"Shuttle", "Shuttlecock", "Birdie", "Badminton", "Ball"}) do
        local direct = workspace:FindFirstChild(name, true)
        if direct and direct:IsA("BasePart") and not direct:IsDescendantOf(character) then
            return direct
        end
    end

    -- 2. Search by model and naming patterns
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(character) then
            local lName = string.lower(obj.Name)
            if (string.find(lName, "shuttle") or string.find(lName, "birdie") or string.find(lName, "badminton"))
               and not string.find(lName, "gui") and not string.find(lName, "spawner") and not string.find(lName, "net") then
                return obj
            end
        end
    end

    -- 3. Dynamic physics search (moving unanchored projectile)
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("BasePart") and not obj.Anchored and obj.AssemblyLinearVelocity.Magnitude > 6 then
            if obj.Size.Magnitude < 6 and not Players:GetPlayerFromCharacter(obj.Parent) then
                return obj
            end
        end
    end
    return nil
end

-- Locate Opponent / Enemy Court
local function getEnemyTargetPos()
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return Vector3.zero end

    local closestDist = math.huge
    local targetPos = nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local eRoot = p.Character.HumanoidRootPart
            local dist = (root.Position - eRoot.Position).Magnitude
            if dist > 18 and dist < closestDist then
                closestDist = dist
                targetPos = eRoot.Position
            end
        end
    end

    if not targetPos then
        targetPos = root.Position + (root.CFrame.LookVector * 60)
    end
    return targetPos
end

-- =======================================================
-- MULTI-ACTION SWING / PUNCH ENGINE
-- =======================================================
local isPunching = false

local function performPunch(enemyPos)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- 1. Aim directly towards opponent's court
    if enemyPos then
        root.CFrame = CFrame.new(root.Position, Vector3.new(enemyPos.X, root.Position.Y, enemyPos.Z))
    end

    -- 2. Trigger equipped racket tool
    local tool = character:FindFirstChildWhichIsA("Tool")
    if tool then
        tool:Activate()
    end

    -- 3. Trigger Game Mobile Swing Buttons (Right Side of Screen)
    pcall(function()
        local pGui = player:FindFirstChild("PlayerGui")
        if pGui then
            local screenWidth = workspace.CurrentCamera.ViewportSize.X
            for _, btn in ipairs(pGui:GetDescendants()) do
                if (btn:IsA("ImageButton") or btn:IsA("TextButton")) and btn.Visible then
                    if btn.AbsolutePosition.X > (screenWidth * 0.45) then
                        local bName = string.lower(btn.Name)
                        local img = string.lower(btn:IsA("ImageButton") and btn.Image or "")
                        if string.find(bName, "hit") or string.find(bName, "swing") or string.find(bName, "shuttle")
                           or string.find(bName, "smash") or string.find(img, "shuttle") or string.find(bName, "action") then
                            if firesignal then
                                firesignal(btn.Activated)
                                firesignal(btn.MouseButton1Click)
                                firesignal(btn.MouseButton1Down)
                            elseif getconnections then
                                for _, conn in ipairs(getconnections(btn.Activated)) do conn:Fire() end
                                for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do conn:Fire() end
                            end
                        end
                    end
                end
            end
        end
    end)

    -- 4. Screen Tap Simulation (Mobile Swing Area)
    pcall(function()
        local camSize = workspace.CurrentCamera.ViewportSize
        local tapX = camSize.X * 0.85
        local tapY = camSize.Y * 0.70
        VirtualUser:Button1Down(Vector2.new(tapX, tapY), workspace.CurrentCamera.CFrame)
        task.wait(0.03)
        VirtualUser:Button1Up(Vector2.new(tapX, tapY), workspace.CurrentCamera.CFrame)
    end)

    -- 5. Fire Game Network Remotes
    pcall(function()
        for _, r in ipairs(ReplicatedStorage:GetDescendants()) do
            if r:IsA("RemoteEvent") then
                local rName = string.lower(r.Name)
                if string.find(rName, "hit") or string.find(rName, "swing") or string.find(rName, "smash") or string.find(rName, "play") then
                    r:FireServer(enemyPos)
                end
            end
        end
    end)
end

-- =======================================================
-- AUTO-FOLLOW & AUTO-PUNCH CONTROLLER
-- =======================================================
local autoPunchEnabled = false
local autoFollowEnabled = false
local rushSpeedValue = 38

RunService.Heartbeat:Connect(function()
    if not (autoPunchEnabled or autoFollowEnabled) then return end

    local root = character and character:FindFirstChild("HumanoidRootPart")
    local hum = character and character:FindFirstChildWhichIsA("Humanoid")
    if not root or not hum then return end

    local shuttle = getActiveShuttle()
    if shuttle and shuttle.Parent then
        local flatDistance = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(shuttle.Position.X, 0, shuttle.Position.Z)).Magnitude
        local totalDistance = (root.Position - shuttle.Position).Magnitude

        -- Follow / Rush towards badminton position
        if autoFollowEnabled and flatDistance > 3.5 then
            hum.WalkSpeed = rushSpeedValue
            hum:MoveTo(Vector3.new(shuttle.Position.X, root.Position.Y, shuttle.Position.Z))
        end

        -- Auto-Punch when badminton enters striking zone
        if autoPunchEnabled and totalDistance <= 16 and not isPunching then
            isPunching = true

            local enemyPos = getEnemyTargetPos()

            -- High Lob Aerial Jump Counter
            if shuttle.Position.Y > (root.Position.Y + 4) then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end

            performPunch(enemyPos)
            task.wait(0.22)
            isPunching = false
        end
    else
        if hum.WalkSpeed == rushSpeedValue then
            hum.WalkSpeed = 16
        end
    end
end)

-- =======================================================
-- BADMINTON COLOR SCANNER / ESP
-- =======================================================
local scanEnabled = true
local currentHighlight = nil
local currentBillboard = nil

local function removeBallVisuals()
    if currentHighlight and currentHighlight.Parent then
        currentHighlight:Destroy()
        currentHighlight = nil
    end
    if currentBillboard and currentBillboard.Parent then
        currentBillboard:Destroy()
        currentBillboard = nil
    end
end

RunService.RenderStepped:Connect(function()
    if not scanEnabled then
        removeBallVisuals()
        return
    end

    local shuttle = getActiveShuttle()
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if shuttle and shuttle.Parent then
        if not currentHighlight or currentHighlight.Adornee ~= shuttle then
            removeBallVisuals()

            local hl = Instance.new("Highlight")
            hl.Name = "BadmintonHighlight"
            hl.FillColor = THEME.BallNeon
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.FillTransparency = 0.2
            hl.OutlineTransparency = 0
            hl.Adornee = shuttle
            hl.Parent = shuttle
            currentHighlight = hl

            local bill = Instance.new("BillboardGui")
            bill.Name = "BadmintonTracker"
            bill.Size = UDim2.new(0, 100, 0, 30)
            bill.AlwaysOnTop = true
            bill.Adornee = shuttle

            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.TextColor3 = THEME.BallNeon
            txt.TextStrokeTransparency = 0
            txt.Font = Enum.Font.GothamBold
            txt.TextSize = 11
            txt.Text = "🏸 BADMINTON"
            txt.Parent = bill

            bill.Parent = shuttle
            currentBillboard = bill
        end

        if currentBillboard and root then
            local dist = math.floor((root.Position - shuttle.Position).Magnitude * 0.28)
            local lbl = currentBillboard:FindFirstChildWhichIsA("TextLabel")
            if lbl then
                lbl.Text = string.format("🏸 BADMINTON\n%dm", dist)
            end
        end
    else
        removeBallVisuals()
    end
end)

